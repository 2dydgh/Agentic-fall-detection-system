# AI Fall Detection Project Git Ignore
# Generated to protect sensitive data and prevent uploading huge model/video files

# Python Environments & Caches
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/

# Sensitive Data & Keys
.env
secret.json
credentials.json

# Database & Logs
incidents.db
logs/
run/
*.log

# Heavy Machine Learning Models & Weights
models/*.pt
models/*.onnx
*.weights

# Datasets, Input & Output Videos
input/*.mp4
input/*.avi
output/*.mp4
output/*.avi
snapshots/
reports/
tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Frontend / Next.js (already covered in frontend/.gitignore, but good to have)
node_modules/
.next/
out/
build/

# Data (datasets, audio samples)
data/

# Docs (plans, internal notes)
# 공개 문서(ARCHITECTURE/ONTOLOGY/DEVELOPMENT)만 추적하고 나머지는 제외한다.
# 디렉터리 자체를 제외하면 git 이 안으로 들어가지 않아 예외가 먹지 않으므로
# docs/ 가 아니라 docs/* 로 적는다.
docs/*
!docs/*.md
docs/comparison_results.md
docs/superpowers/

# Claude Code
CLAUDE.md
